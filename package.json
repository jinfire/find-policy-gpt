{
  "name": "find-policy-gpt",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 3002",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.catalog.jsonc",
    "db:seed:generate": "node scripts/generate-policy-seed.mjs",
    "catalog:sync": "tsx scripts/sync-gov24-catalog.ts",
    "catalog:apply:local": "wrangler d1 execute DB --local --file=.local/gov24-catalog.sql --config wrangler.catalog.jsonc",
    "catalog:sync:local": "npm run db:migrate:local && npm run catalog:sync && npm run catalog:apply:local",
    "policy:links": "node scripts/check-policy-links.mjs",
    "policy:freshness": "tsx scripts/check-policy-freshness.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^26.1.0",
    "react-server-dom-webpack": "^19.2.8",
    "sql.js": "^1.14.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
